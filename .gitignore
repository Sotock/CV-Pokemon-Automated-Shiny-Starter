# IDE
.idea/
*.iml

# Local ROMs and emulator binaries
roms/*
emulators/*

# User save profiles
saves/*

# Temporary instances
temp/*

# Generated screenshots
pictures/*

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Preserve directory structure
!roms/.gitkeep
!emulators/.gitkeep
!saves/.gitkeep
!temp/.gitkeep
!pictures/.gitkeep

# Dataset save manipulation
/save manip/
