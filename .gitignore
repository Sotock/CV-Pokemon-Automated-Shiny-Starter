# IDE
.idea/
*.iml

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Local ROMs and emulator binaries
/roms/
/roms_original/
/roms_demo/
/roms_shiny_patch/*
/emulators/*

# Permanent save profiles and exported saves
/saves/*
/exports/

# Temporary instances and generated screenshots
/temp/*
/pictures/*

# Dataset save manipulation
/save manip/

# Local application settings
/settings.json
/settings.tmp

# Distribution and build output
/build/
/dist/

# Preserve directory structure
!/roms_shiny_patch/.gitkeep
!/emulators/.gitkeep
!/saves/.gitkeep
!/temp/.gitkeep
!/pictures/.gitkeep